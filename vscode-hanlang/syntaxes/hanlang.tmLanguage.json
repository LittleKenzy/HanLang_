{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HanLang",
  "scopeName": "source.hanlang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords-control" },
    { "include": "#keywords-declaration" },
    { "include": "#keywords-operator" },
    { "include": "#keywords-other" },
    { "include": "#function-declaration" },
    { "include": "#function-call-builtin" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.hash.hanlang",
      "match": "#.*$"
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.hanlang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.hanlang",
              "match": "\\\\[nrtv0\\\\\"'{}]"
            },
            {
              "name": "meta.interpolation.hanlang",
              "begin": "(?<!\\\\)\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.hanlang" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.hanlang" }
              },
              "patterns": [
                { "include": "#numbers" },
                { "include": "#constants" },
                { "include": "#keywords-operator" },
                { "include": "#function-call-builtin" },
                { "include": "#function-call" },
                { "include": "#operators" },
                { "include": "#identifiers" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.hanlang",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.hanlang",
              "match": "\\\\[nrtv0\\\\'\"{}]"
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.hanlang",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.hanlang",
          "match": "\\b\\d+\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.hanlang",
          "match": "\\bBenar\\b"
        },
        {
          "name": "constant.language.boolean.false.hanlang",
          "match": "\\bSalah\\b"
        },
        {
          "name": "constant.language.null.hanlang",
          "match": "\\bkosong\\b"
        }
      ]
    },

    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.conditional.hanlang",
          "match": "\\b(jika_tidak_jika|jika_tidak|jika|cocokkan|pola|lainnya)\\b"
        },
        {
          "name": "keyword.control.loop.hanlang",
          "match": "\\b(ulangi|untuk|selama|dalam|berhenti|lanjut)\\b"
        },
        {
          "name": "keyword.control.flow.hanlang",
          "match": "\\b(kembali|coba|tangkap|akhirnya)\\b"
        },
        {
          "name": "keyword.control.import.hanlang",
          "match": "\\b(impor|dari)\\b"
        }
      ]
    },

    "keywords-declaration": {
      "patterns": [
        {
          "name": "keyword.declaration.function.hanlang",
          "match": "\\b(fungsi)\\b"
        },
        {
          "name": "keyword.declaration.variable.hanlang",
          "match": "\\b(tetapkan|konstan)\\b"
        },
        {
          "name": "keyword.declaration.class.hanlang",
          "match": "\\b(kelas)\\b"
        },
        {
          "name": "keyword.declaration.test.hanlang",
          "match": "\\b(uji|pastikan)\\b"
        }
      ]
    },

    "keywords-operator": {
      "patterns": [
        {
          "name": "keyword.operator.logical.hanlang",
          "match": "\\b(dan|atau|bukan)\\b"
        },
        {
          "name": "keyword.other.hanlang",
          "match": "\\b(diri|jelajahi)\\b"
        }
      ]
    },

    "keywords-other": {
      "patterns": []
    },

    "function-declaration": {
      "match": "\\b(fungsi)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
      "captures": {
        "1": { "name": "keyword.declaration.function.hanlang" },
        "2": { "name": "entity.name.function.hanlang" }
      }
    },

    "function-call-builtin": {
      "match": "\\b(tampil|masukan|bilangan|teks|desimal|boolean|tipe|adalah|panjang|rentang|tambah|hapus|gabung|pisah|urutkan|balik|berisi|kunci|nilai|abs|bulat|min|max|saring|ubah)\\s*\\(",
      "captures": {
        "1": { "name": "support.function.builtin.hanlang" }
      }
    },

    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
      "captures": {
        "1": { "name": "entity.name.function.call.hanlang" }
      }
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.hanlang",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.hanlang",
          "match": "=>"
        },
        {
          "name": "keyword.operator.comparison.hanlang",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.compound.hanlang",
          "match": "\\+=|-=|\\*=|/="
        },
        {
          "name": "keyword.operator.assignment.hanlang",
          "match": "(?<!=|!)=(?!=)"
        },
        {
          "name": "keyword.operator.arithmetic.hanlang",
          "match": "\\*\\*|//|[+\\-*/%]"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.bracket.curly.hanlang",
          "match": "[{}]"
        },
        {
          "name": "punctuation.bracket.round.hanlang",
          "match": "[()]"
        },
        {
          "name": "punctuation.bracket.square.hanlang",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.comma.hanlang",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.hanlang",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.dot.hanlang",
          "match": "\\."
        }
      ]
    },

    "identifiers": {
      "name": "variable.other.hanlang",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
